NEXT_PUBLIC_SITE_URL=https://posleslovie.online
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_AMOCRM_WORKER_URL=https://posleslovie-amocrm.kailgurika.workers.dev/
NEXT_PUBLIC_PRODUCT_PRICE=999

# Yandex.Metrica counter id (digits only). Leave empty to disable analytics.
NEXT_PUBLIC_YANDEX_METRICA_ID=109695414

# Cloudflare Turnstile bot protection (site key). Leave empty to disable the widget.
# The matching secret goes on the AmoCRM worker as the TurnstileSecret variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: endpoint that receives client error reports (e.g. a logging worker). Leave empty to disable.
NEXT_PUBLIC_ERROR_REPORT_URL=

# Cloudflare CMS OAuth worker variables
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_DOMAINS=posleslovie.online,www.posleslovie.online,kaliguri.github.io

# Optional/future integrations
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
